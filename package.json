{
  "name": "ha-notifications-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && mkdir -p dist custom_components/ha_notifications/dist && esbuild frontend/panel.ts --bundle --format=esm --outfile=dist/panel.js && cp dist/panel.js custom_components/ha_notifications/dist/panel.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write frontend/**/*.ts tests/frontend_smoke.mjs",
    "test:frontend": "node tests/frontend_smoke.mjs",
    "test:unit": "vitest run",
    "clean": "rm -rf dist",
    "export:hacs": "sh scripts/export_hacs.sh",
    "package:hacs": "sh scripts/package_hacs.sh",
    "install:ha": "sh scripts/install_local.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "lit": "^3.3.1",
    "prettier": "^3.8.3",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
