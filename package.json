{
  "name": "ha-notifications-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf build && cp -R custom_components/ha_notifications/. build/ && esbuild frontend/panel.ts --bundle --format=esm --outfile=build/frontend/panel.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write 'frontend/**/*.ts' 'tests/frontend_smoke.test.ts'",
    "lint:backend": "ruff check custom_components/ha_notifications tests/backend",
    "test": "npm run typecheck && npm run build &&  vitest run",
    "ui:preview": "npm run build && node scripts/ui_preview.mjs",
    "clean": "rm -rf dist",
    "package:hacs": "npm run build && sh scripts/package_hacs.sh"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "lit": "^3.3.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
