{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "rootDir": "./custom_components/ha_notifications/frontend",
    "outDir": "./custom_components/ha_notifications/frontend/dist",
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["custom_components/ha_notifications/frontend/**/*.ts"],
  "exclude": ["custom_components/ha_notifications/frontend/dist"]
}
