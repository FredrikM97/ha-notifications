{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "rootDir": "./frontend",
    "outDir": "./frontend/dist",
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["frontend/**/*.ts"],
  "exclude": ["frontend/dist"]
}
