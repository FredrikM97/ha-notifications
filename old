    description: ''
    enabled: true
    icon: mdi:sprout
    id: jordmatare_fuktniva
    mobile_options:
      android:
        enabled: true
      general: {}
      ios: {}
    monitor:
      automation_mode: parallel
      conditions:
        enabled: true
        interval: 43200
        items:
          - condition: template
            value_template: >-
              {% set threshold = 20 %} {% set ns = namespace(low=false) %} {%
              for dev_id in label_devices('jordmätare') %}
                {% for entity_id in device_entities(dev_id) | select('match', '.*moisture.*') %}
                  {% if states(entity_id) not in ['unknown', 'unavailable']
                        and states(entity_id) | int(100) < threshold %}
                    {% set ns.low = true %}
                  {% endif %}
                {% endfor %}
              {% endfor %} {{ ns.low }}
        periodic: false
        startup: true
      inactive:
        clear_notification: false
        enabled: false
        items: []
      triggers:
        enabled: true
        items:
          - trigger: template
            value_template: >-
              {% set threshold = 20 %} {% set ns = namespace(low=false) %} {%
              for dev_id in label_devices('jordmätare') %}
                {% for entity_id in device_entities(dev_id) | select('match', '.*moisture.*') %}
                  {% if states(entity_id) not in ['unknown', 'unavailable']
                        and states(entity_id) | int(100) < threshold %}
                    {% set ns.low = true %}
                  {% endif %}
                {% endfor %}
              {% endfor %} {{ ns.low }}
    name: Jordmätare fuktnivå
    notification:
      data:
        message: One or more soil moisture sensors are below 20%.
        persistent: true
        sticky: true
        title: Jordmätare fuktnivå
      message: ''
      target:
        label_id:
          - phone
      title: ''
