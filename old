    description: ''
    enabled: false
    icon: mdi:battery-alert
    id: battery_low
    monitor:
      automation_mode: parallel
      conditions:
        enabled: true
        items:
          - condition: template
            value_template: |
              {% set threshold = 20 %}
              {{ states.sensor
                | selectattr('attributes.device_class', 'eq', 'battery')
                | selectattr('state', 'is_number')
                | map(attribute='state')
                | map('int', 100)
                | select('lt', threshold)
                | list
                | count > 0 }}
        periodic: false
        startup: true
      inactive:
        clear_notification: false
        enabled: false
        items: []
      triggers:
        enabled: true
        items: []
    name: Battery low detection
    notification:
      data:
        message: One or more battery sensors are below 20%.
        title: Battery low
      message: ''
      target:
        label_id:
          - phone
      title: ''
