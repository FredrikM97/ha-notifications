        'target': dict({
          'entity_id': list([
            'notify.mobile_app_phone',
          ]),
        }),
        'use_default_tag': True,
      }),
    }),
    'nested-data': dict({
      'delivered': list([
        dict({
          'data': dict({
            'data': dict({
              'channel': 'Alerts',
              'group': 'water',
              'priority': 'high',
              'push': dict({
                'sound': dict({
                  'critical': 1,
