    'empty-payload': dict({
      'delivered': list([
        dict({
          'data': dict({
            'tag': 'water',
          }),
          'message': 'clear_notification',
        }),
      ]),
      'history_args': tuple(
        'water',
        'water',
        'notification_cleared',
        'Notification cleared',
        dict({
          'service': 'notify.mobile_app_phone',
        }),
      ),
      'history_kwargs': dict({
      }),
    }),
    'integration-metadata': dict({
      'delivered': list([
        dict({
          'data': dict({
            'priority': 'high',
            'tag': 'base_alert',
          }),
          'message': 'clear_notification',
          'title': 'Water',
        }),
      ]),
      'history_args': tuple(
        'base_alert',
        'Test alert',
        'notification_cleared',
        'Notification cleared',
        dict({
          'reason': 'native_boundary',
          'service': 'notify.mobile_app_phone',
        }),
      ),
      'history_kwargs': dict({
        'flow_id': 'flow-1',
      }),
    }),
  })
