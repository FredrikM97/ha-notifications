              }),
              'inactive': dict({
                'clear_notification': False,
                'enabled': False,
                'items': list([
                ]),
              }),
              'triggers': dict({
                'enabled': True,
                'items': list([
                  dict({
                    'entity_id': 'binary_sensor.door',
                    'trigger': 'state',
                  }),
                  dict({
                    'entity_id': 'binary_sensor.window',
                    'trigger': 'state',
                  }),
                  dict({
                    'entity_id': 'sensor.temperature',
                    'trigger': 'state',
                  }),
