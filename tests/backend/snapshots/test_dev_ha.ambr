# name: test_onboard_uses_requested_port
  list([
    tuple(
      'http://127.0.0.1:8125/api/onboarding/users',
      dict({
        'json': dict({
          'client_id': 'http://localhost:8125/',
          'language': 'en',
          'name': 'Developer',
          'password': 'dev',
          'username': 'dev',
        }),
      }),
    ),
    tuple(
      'http://127.0.0.1:8125/auth/token',
      dict({
        'data': dict({
          'client_id': 'http://localhost:8125/',
          'code': 'auth-code',
          'grant_type': 'authorization_code',
        }),
      }),
    ),
    tuple(
      'http://127.0.0.1:8125/api/onboarding/core_config',
      dict({
        'headers': dict({
          'Authorization': 'Bearer access-token',
        }),
        'json': None,
      }),
    ),
    tuple(
      'http://127.0.0.1:8125/api/onboarding/analytics',
      dict({
        'headers': dict({
          'Authorization': 'Bearer access-token',
        }),
        'json': None,
      }),
    ),
    tuple(
      'http://127.0.0.1:8125/api/onboarding/integration',
      dict({
        'headers': dict({
          'Authorization': 'Bearer access-token',
        }),
        'json': dict({
          'client_id': 'http://localhost:8125/',
          'redirect_uri': 'http://localhost:8125/?auth_callback=1',
        }),
      }),
    ),
  ])
