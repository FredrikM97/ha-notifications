# name: test_full_feature_configuration_preserves_confirmation_actions_without_post_send_action
  dict({
    'alerts': list([
      dict({
        'confirmation': dict({
          'actions': dict({
            'enabled': True,
            'items': list([
              dict({
                'action': 'light.turn_on',
                'target': dict({
                  'entity_id': 'light.hall',
                }),
              }),
            ]),
          }),
          'buttons': list([
            dict({
              'id': 'confirm',
              'label': 'Confirm',
            }),
          ]),
          'enabled': True,
          'notification': dict({
            'action': 'notify.mobile_app_phone',
            'enabled': True,
            'message': 'Confirmed',
            'options': dict({
            }),
            'title': '',
            'use_default_tag': True,
          }),
          'reminders': dict({
            'enabled': True,
            'forget_after': dict({
              'enabled': False,
              'value': 900,
            }),
            'interval': dict({
              'minutes': 15,
            }),
            'max_attempts': 5,
            'show_attempts': True,
          }),
        }),
        'description': '',
        'enabled': True,
        'icon': 'mdi:bell-outline',
        'id': 'full_feature',
        'monitor': dict({
          'conditions': dict({
            'enabled': True,
            'interval': dict({
              'enabled': False,
              'value': 43200,
            }),
            'items': list([
              dict({
                'condition': 'and',
                'conditions': list([
                  dict({
                    'condition': 'or',
                    'conditions': list([
                      dict({
                        'condition': 'state',
                        'entity_id': 'binary_sensor.door',
                        'state': 'on',
                      }),
                      dict({
                        'above': 30,
                        'condition': 'numeric_state',
                        'entity_id': 'sensor.temperature',
                      }),
                    ]),
                  }),
                  dict({
                    'condition': 'state',
                    'entity_id': 'binary_sensor.window',
                    'state': 'on',
                  }),
                ]),
              }),
            ]),
            'startup': True,
          }),
          'inactive': dict({
            'clear_notification': False,
            'enabled': False,
            'items': list([
            ]),
          }),
          'triggers': dict({
            'enabled': True,
            'items': list([
              dict({
                'entity_id': 'binary_sensor.door',
                'trigger': 'state',
              }),
              dict({
                'entity_id': 'binary_sensor.window',
                'trigger': 'state',
              }),
              dict({
                'entity_id': 'sensor.temperature',
                'trigger': 'state',
              }),
            ]),
          }),
        }),
        'name': 'Full feature',
        'notification': dict({
          'action': 'notify.mobile_app_phone',
          'message': 'Door open',
          'options': dict({
          }),
          'target': dict({
            'entity_id': list([
              'notify.mobile_app_phone',
            ]),
          }),
          'title': '',
          'use_default_tag': True,
        }),
      }),
    ]),
    'version': 1,
  })
