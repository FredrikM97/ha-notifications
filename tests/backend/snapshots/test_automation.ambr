# ---
# name: test_generated_option_controls_are_independent_for_main_reminders_and_follow_up[disabled_field]
  '''
  id: ha_notifications_low_water
  alias: 'HA Notifications: Low water'
  description: Generated by HA Notifications. Do not edit manually.
  initial_state: true
  mode: parallel
  triggers:
  - trigger: homeassistant
    event: start
    id: '0'
  - trigger: state
    entity_id: sensor.water
    id: '1'
  conditions:
  - condition: numeric_state
    entity_id: sensor.water
    below: 20
  actions:
  - action: ha_notifications.report
    data:
      alert_id: low_water
      alert_name: Low water
      status: started
      flow_id: '{{ context.parent_id or context.id }}'
      run_id: '{{ context.parent_id or context.id }}'
      details:
        action: automation_started
        started_by:
          platform: '{{ trigger.platform if trigger is defined and trigger.platform
            is defined else '''' }}'
          id: '{{ trigger.id if trigger is defined and trigger.id is defined else ''''
            }}'
          description: '{{ (trigger | default({})).description | default('''', true)
            }}'
          entity_id: '{{ trigger.entity_id if trigger is defined and trigger.entity_id
            is defined else '''' }}'
          from_state: '{{ trigger.from_state.state if trigger is defined and trigger.from_state
            is defined and trigger.from_state else '''' }}'
          to_state: '{{ trigger.to_state.state if trigger is defined and trigger.to_state
            is defined and trigger.to_state else '''' }}'
          event_type: '{{ trigger.event.event_type if trigger is defined and trigger.platform
            == ''event'' and trigger.event is defined and trigger.event else '''' }}'
  - action: ha_notifications.send
    data:
      alert_id: low_water
      alert_name: Low water
      flow_id: '{{ context.parent_id or context.id }}'
      use_default_tag: true
      payload:
        title: ''
        message: Low water
        data:
          push:
            sound: main.aiff
          actions:
          - action: ha_notifications_low_water_confirmation_confirm
            title: Done
      action: notify.mobile_app_phone
      target:
        entity_id:
        - notify.phone
        - notify.tablet
  - action: ha_notifications.report
    data:
      alert_id: low_water
      alert_name: Low water
      status: waiting
      flow_id: '{{ context.parent_id or context.id }}'
      run_id: '{{ context.parent_id or context.id }}'
      message: Waiting for confirmation
      details:
        action: confirmation_waiting
  - wait_for_trigger:
    - trigger: event
      event_type: mobile_app_notification_action
      id: confirmation
      event_data:
        action: ha_notifications_low_water_confirmation_confirm
    - trigger: event
      event_type: ha_notifications_command
      id: cancel_run
      event_data:
        alert_id: low_water
        command: cancel_run
    - trigger: event
      event_type: ha_notifications_command
      id: skip_confirmation
      event_data:
        alert_id: low_water
        command: skip_confirmation
    timeout: 1800
    continue_on_timeout: true
  - choose:
    - conditions:
      - condition: template
        value_template: '{{ wait.trigger.id == ''confirmation'' }}'
      sequence:
      - action: ha_notifications.report
        data:
          alert_id: low_water
          alert_name: Low water
          status: confirmation_completed
          flow_id: '{{ context.parent_id or context.id }}'
          run_id: '{{ context.parent_id or context.id }}'
          message: Confirmation completed
          details:
            action: confirmation_completed
            device_id: '{{ wait.trigger.event.data.device_id | default('''', true) }}'
            user_id: '{{ wait.trigger.event.context.user_id | default('''', true) }}'
      - action: ha_notifications.send
        data:
          alert_id: low_water
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          use_default_tag: true
          payload:
            title: ''
            message: '{% raw %}Done{% endraw %}'
            data:
              channel: Follow-up saved
              ttl: 0
              sticky: false
              push:
                custom:
                  values:
                  - false
                  - 0
          target:
            entity_id:
            - notify.phone
            - notify.tablet
          action: notify.mobile_app_phone
          confirmation:
            device_id: '{{ wait.trigger.event.data.device_id | default('''', true) }}'
            user_id: '{{ wait.trigger.event.context.user_id | default('''', true) }}'
          history_reason: confirmation_notification
      - stop: confirmation completed
    - conditions:
      - condition: template
        value_template: '{{ wait.trigger.id == ''cancel_run'' }}'
      sequence:
      - action: ha_notifications.report
        data:
          alert_id: low_water
          alert_name: Low water
          status: cancelled
          flow_id: '{{ context.parent_id or context.id }}'
          run_id: '{{ context.parent_id or context.id }}'
          message: Automation run cancelled
          details:
            action: confirmation_cancelled
      - stop: Confirmation ended
    default:
    - repeat:
        count: 2
        sequence:
        - action: ha_notifications.send
          data:
            alert_id: low_water
            alert_name: Low water
            flow_id: '{{ context.parent_id or context.id }}'
            use_default_tag: true
            payload:
              title: ''
              message: Low water
              data:
                push:
                  sound: main.aiff
                actions:
                - action: ha_notifications_low_water_confirmation_confirm
                  title: Done
            action: notify.mobile_app_phone
            target:
              entity_id:
              - notify.phone
              - notify.tablet
        - action: ha_notifications.report
          data:
            alert_id: low_water
            alert_name: Low water
            status: confirmation_reminder
            flow_id: '{{ context.parent_id or context.id }}'
            message: Confirmation reminder sent
            details:
              action: confirmation_reminder
              repeat: '{{ repeat.index }}'
        - action: ha_notifications.report
          data:
            alert_id: low_water
            alert_name: Low water
            status: waiting
            flow_id: '{{ context.parent_id or context.id }}'
            run_id: '{{ context.parent_id or context.id }}'
            message: Waiting for confirmation
            details:
              action: confirmation_waiting
        - wait_for_trigger:
          - trigger: event
            event_type: mobile_app_notification_action
            id: confirmation
            event_data:
              action: ha_notifications_low_water_confirmation_confirm
          - trigger: event
            event_type: ha_notifications_command
            id: cancel_run
            event_data:
              alert_id: low_water
              command: cancel_run
          - trigger: event
            event_type: ha_notifications_command
            id: skip_confirmation
            event_data:
              alert_id: low_water
              command: skip_confirmation
          timeout: 1800
          continue_on_timeout: true
        - choose:
          - conditions:
            - condition: template
              value_template: '{{ wait.trigger.id == ''confirmation'' }}'
            sequence:
            - action: ha_notifications.report
              data:
                alert_id: low_water
                alert_name: Low water
                status: confirmation_completed
                flow_id: '{{ context.parent_id or context.id }}'
                run_id: '{{ context.parent_id or context.id }}'
                message: Confirmation completed
                details:
                  action: confirmation_completed
                  device_id: '{{ wait.trigger.event.data.device_id | default('''', true)
                    }}'
                  user_id: '{{ wait.trigger.event.context.user_id | default('''', true)
                    }}'
            - action: ha_notifications.send
              data:
                alert_id: low_water
                alert_name: Low water
                flow_id: '{{ context.parent_id or context.id }}'
                use_default_tag: true
                payload:
                  title: ''
                  message: '{% raw %}Done{% endraw %}'
                  data:
                    channel: Follow-up saved
                    ttl: 0
                    sticky: false
                    push:
                      custom:
                        values:
                        - false
                        - 0
                target:
                  entity_id:
                  - notify.phone
                  - notify.tablet
                action: notify.mobile_app_phone
                confirmation:
                  device_id: '{{ wait.trigger.event.data.device_id | default('''', true)
                    }}'
                  user_id: '{{ wait.trigger.event.context.user_id | default('''', true)
