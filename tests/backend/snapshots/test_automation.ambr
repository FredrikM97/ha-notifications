# name: test_generated_tag_metadata_is_independent_for_main_and_follow_up[False-False]
  '''
  - id: ha_notifications_low_water
    alias: 'HA Notifications: Low water'
    description: Generated by HA Notifications. Do not edit manually.
    initial_state: true
    mode: parallel
    triggers:
    - trigger: homeassistant
      event: start
      id: '0'
    - trigger: state
      entity_id: sensor.water
      id: '1'
    - trigger: event
      event_type: inactive
      id: inactive_0
    conditions: []
    actions:
    - choose:
      - conditions:
        - condition: trigger
          id:
          - inactive_0
        sequence:
        - action: ha_notifications.clear
          data:
            alert_id: low_water
            alert_name: Low water
