                - trigger: event
                  event_type: ha_notifications_command
                  id: cancel_run
                  event_data:
                    alert_id: low_water
                    command: cancel_run
                - trigger: event
                  event_type: ha_notifications_command
                  id: skip_confirmation
                  event_data:
                    alert_id: low_water
                    command: skip_confirmation
                timeout: 1800
