# serializer version: 1
# name: test_automation_boundary_preserves_persisted_native_extensions
  '''
  stored:
    id: extended
    name: Extended
    enabled: true
    description: ''
    icon: mdi:bell-outline
    monitor:
      triggers:
        enabled: true
        items: []
      conditions:
        enabled: true
        items: []
        startup: true
        interval:
          enabled: false
          value: 43200
      inactive:
        enabled: false
        items: []
        clear_notification: false
    notification:
      action: notify.mobile_app_phone
      target: {}
      title: ''
      message: ''
      use_default_tag: true
      options:
        native_notification:
          priority: high
    confirmation:
      enabled: true
      buttons:
      - id: confirm
        label: Confirm
        button_native: value
      notification:
        action: notify.mobile_app_phone
        title: ''
        message: ''
        use_default_tag: true
        options:
          native_confirmation:
            channel: alerts
        enabled: true
      reminders:
        enabled: true
        interval:
          minutes: 5
        max_attempts: 2
        show_attempts: false
        forget_after:
          enabled: false
          value: 900
        reminder_native: true
      actions:
        enabled: false
        items: []
      confirmation_native: value
    post_send_actions:
      enabled: true
      items:
      - action: light.turn_on
  generated:
    id: ha_notifications_extended
    alias: 'HA Notifications: Extended'
    description: Generated by HA Notifications. Do not edit manually.
    initial_state: true
    mode: parallel
    triggers:
    - trigger: homeassistant
      event: start
      id: '0'
    conditions: []
    actions:
    - action: ha_notifications.report
      data:
        alert_id: extended
        alert_name: Extended
        status: started
        flow_id: '{{ context.parent_id or context.id }}'
        run_id: '{{ context.parent_id or context.id }}'
        details:
          action: automation_started
          started_by:
            platform: '{{ trigger.platform if trigger is defined and trigger.platform
              is defined else '''' }}'
            id: '{{ trigger.id if trigger is defined and trigger.id is defined else
              '''' }}'
            description: '{{ (trigger | default({})).description | default('''', true)
              }}'
            entity_id: '{{ trigger.entity_id if trigger is defined and trigger.entity_id
              is defined else '''' }}'
            from_state: '{{ trigger.from_state.state if trigger is defined and trigger.from_state
              is defined and trigger.from_state else '''' }}'
            to_state: '{{ trigger.to_state.state if trigger is defined and trigger.to_state
              is defined and trigger.to_state else '''' }}'
            event_type: '{{ trigger.event.event_type if trigger is defined and trigger.platform
              == ''event'' and trigger.event is defined and trigger.event else ''''
              }}'
    - action: ha_notifications.send
      data:
        alert_id: extended
        alert_name: Extended
        flow_id: '{{ context.parent_id or context.id }}'
        use_default_tag: true
        payload:
          title: ''
          message: ''
          data:
            native_notification:
              priority: high
            actions:
            - action: ha_notifications_extended_confirmation_confirm
              title: Confirm
        action: notify.mobile_app_phone
    - action: light.turn_on
    - action: ha_notifications.report
      data:
        alert_id: extended
        alert_name: Extended
        status: action_executed
        flow_id: '{{ context.parent_id or context.id }}'
        run_id: '{{ context.parent_id or context.id }}'
        message: Automation action executed
        details:
          action: light.turn_on
    - action: ha_notifications.report
      data:
        alert_id: extended
        alert_name: Extended
        status: waiting
        flow_id: '{{ context.parent_id or context.id }}'
        run_id: '{{ context.parent_id or context.id }}'
        message: Waiting for confirmation
        details:
          action: confirmation_waiting
    - wait_for_trigger:
      - trigger: event
        event_type: mobile_app_notification_action
        id: confirmation
        event_data:
          action: ha_notifications_extended_confirmation_confirm
      - trigger: event
        event_type: ha_notifications_command
        id: cancel_run
        event_data:
          alert_id: extended
          command: cancel_run
      - trigger: event
        event_type: ha_notifications_command
        id: skip_confirmation
        event_data:
          alert_id: extended
          command: skip_confirmation
      timeout:
        minutes: 5
      continue_on_timeout: true
    - choose:
      - conditions:
        - condition: template
          value_template: '{{ wait.trigger.id == ''confirmation'' }}'
        sequence:
        - action: ha_notifications.report
          data:
            alert_id: extended
            alert_name: Extended
            status: confirmation_completed
            flow_id: '{{ context.parent_id or context.id }}'
            run_id: '{{ context.parent_id or context.id }}'
            message: Confirmation completed
            details:
              action: confirmation_completed
              device_id: '{{ wait.trigger.event.data.device_id | default('''', true)
                }}'
              user_id: '{{ wait.trigger.event.context.user_id | default('''', true)
                }}'
        - action: ha_notifications.send
          data:
            alert_id: extended
            alert_name: Extended
            flow_id: '{{ context.parent_id or context.id }}'
            use_default_tag: true
            payload:
              title: ''
              message: ''
              data:
                native_confirmation:
                  channel: alerts
            action: notify.mobile_app_phone
            history_reason: confirmation_notification
        - stop: confirmation completed
      - conditions:
        - condition: template
          value_template: '{{ wait.trigger.id == ''cancel_run'' }}'
        sequence:
        - action: ha_notifications.report
          data:
            alert_id: extended
            alert_name: Extended
            status: cancelled
            flow_id: '{{ context.parent_id or context.id }}'
            run_id: '{{ context.parent_id or context.id }}'
            message: Automation run cancelled
            details:
              action: confirmation_cancelled
        - stop: Confirmation ended
      default:
      - repeat:
          count: 2
          sequence:
          - action: ha_notifications.send
            data:
              alert_id: extended
              alert_name: Extended
              flow_id: '{{ context.parent_id or context.id }}'
              use_default_tag: true
              payload:
                title: ''
                message: ''
                data:
                  native_notification:
                    priority: high
                  actions:
                  - action: ha_notifications_extended_confirmation_confirm
                    title: Confirm
              action: notify.mobile_app_phone
          - action: ha_notifications.report
            data:
              alert_id: extended
              alert_name: Extended
              status: confirmation_reminder
              flow_id: '{{ context.parent_id or context.id }}'
              message: Confirmation reminder sent
              details:
                action: confirmation_reminder
                repeat: '{{ repeat.index }}'
          - action: ha_notifications.report
            data:
              alert_id: extended
              alert_name: Extended
              status: waiting
              flow_id: '{{ context.parent_id or context.id }}'
              run_id: '{{ context.parent_id or context.id }}'
              message: Waiting for confirmation
              details:
                action: confirmation_waiting
          - wait_for_trigger:
            - trigger: event
              event_type: mobile_app_notification_action
              id: confirmation
              event_data:
                action: ha_notifications_extended_confirmation_confirm
            - trigger: event
              event_type: ha_notifications_command
              id: cancel_run
              event_data:
                alert_id: extended
                command: cancel_run
            - trigger: event
              event_type: ha_notifications_command
              id: skip_confirmation
              event_data:
                alert_id: extended
                command: skip_confirmation
            timeout:
              minutes: 5
            continue_on_timeout: true
          - choose:
            - conditions:
              - condition: template
                value_template: '{{ wait.trigger.id == ''confirmation'' }}'
              sequence:
              - action: ha_notifications.report
                data:
                  alert_id: extended
                  alert_name: Extended
                  status: confirmation_completed
                  flow_id: '{{ context.parent_id or context.id }}'
                  run_id: '{{ context.parent_id or context.id }}'
                  message: Confirmation completed
                  details:
                    action: confirmation_completed
                    device_id: '{{ wait.trigger.event.data.device_id | default('''',
                      true) }}'
                    user_id: '{{ wait.trigger.event.context.user_id | default('''',
                      true) }}'
              - action: ha_notifications.send
                data:
                  alert_id: extended
                  alert_name: Extended
                  flow_id: '{{ context.parent_id or context.id }}'
                  use_default_tag: true
                  payload:
                    title: ''
                    message: ''
                    data:
                      native_confirmation:
                        channel: alerts
                  action: notify.mobile_app_phone
                  history_reason: confirmation_notification
              - stop: confirmation completed
            - conditions:
              - condition: template
                value_template: '{{ wait.trigger.id == ''cancel_run'' }}'
              sequence:
              - action: ha_notifications.report
                data:
                  alert_id: extended
                  alert_name: Extended
                  status: cancelled
                  flow_id: '{{ context.parent_id or context.id }}'
                  run_id: '{{ context.parent_id or context.id }}'
                  message: Automation run cancelled
                  details:
                    action: confirmation_cancelled
              - stop: Confirmation ended
            default: []
      - action: ha_notifications.report
        data:
          alert_id: extended
          alert_name: Extended
          status: confirmation_timeout
          flow_id: '{{ context.parent_id or context.id }}'
          run_id: '{{ context.parent_id or context.id }}'
          message: Confirmation timed out
          details:
            action: confirmation_timeout
      - stop: Confirmation ended
  '''
# ---
# name: test_automation_changes_returns_explicit_document_and_deletion_ids
  '''
  upsert:
  - id: ha_notifications_low_water
    alias: 'HA Notifications: Low water'
    description: Generated by HA Notifications. Do not edit manually.
    initial_state: true
    mode: parallel
    triggers:
    - trigger: homeassistant
      event: start
      id: '0'
    - trigger: state
      entity_id: sensor.water
      id: '1'
    conditions:
    - condition: numeric_state
      entity_id: sensor.water
      below: 20
    actions:
    - action: ha_notifications.report
      data:
        alert_id: low_water
        alert_name: Low water
        status: started
        flow_id: '{{ context.parent_id or context.id }}'
        run_id: '{{ context.parent_id or context.id }}'
        details:
          action: automation_started
          started_by:
            platform: '{{ trigger.platform if trigger is defined and trigger.platform
              is defined else '''' }}'
            id: '{{ trigger.id if trigger is defined and trigger.id is defined else
              '''' }}'
            description: '{{ (trigger | default({})).description | default('''', true)
              }}'
            entity_id: '{{ trigger.entity_id if trigger is defined and trigger.entity_id
              is defined else '''' }}'
            from_state: '{{ trigger.from_state.state if trigger is defined and trigger.from_state
              is defined and trigger.from_state else '''' }}'
            to_state: '{{ trigger.to_state.state if trigger is defined and trigger.to_state
              is defined and trigger.to_state else '''' }}'
            event_type: '{{ trigger.event.event_type if trigger is defined and trigger.platform
              == ''event'' and trigger.event is defined and trigger.event else ''''
              }}'
    - action: ha_notifications.send
      data:
        alert_id: low_water
        alert_name: Low water
        flow_id: '{{ context.parent_id or context.id }}'
        use_default_tag: true
        payload:
          title: ''
          message: Low water
          data: {}
        action: notify.mobile_app_phone
        target:
          entity_id:
          - notify.phone
          - notify.tablet
    - action: ha_notifications.report
      data:
        alert_id: low_water
        alert_name: Low water
        status: completed
        flow_id: '{{ context.parent_id or context.id }}'
        run_id: '{{ context.parent_id or context.id }}'
        details:
          action: automation_completed
  delete:
  - ha_notifications_deleted
  description: Generated by HA Notifications. Do not edit manually.
  '''
