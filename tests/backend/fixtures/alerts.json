          {
            "trigger": "state",
            "entity_id": "binary_sensor.window"
          },
          {
            "trigger": "state",
            "entity_id": "sensor.temperature"
          }
        ]
      },
      "conditions": {
        "startup": true,
        "enabled": true,
        "interval": {
          "enabled": false,
          "value": 43200
        },
        "items": [
          {
            "condition": "and",
            "conditions": [
              {
                "condition": "or",
                "conditions": [
                  {
                    "condition": "state",
                    "entity_id": "binary_sensor.door",
                    "state": "on"
                  },
                  {
                    "condition": "numeric_state",
                    "entity_id": "sensor.temperature",
                    "above": 30
                  }
                ]
              },
              {
                "condition": "state",
                "entity_id": "binary_sensor.window",
                "state": "on"
              }
            ]
          }
        ]
