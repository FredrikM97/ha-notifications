      "enabled": true,
      "actions": [
        {
          "action": "logbook.log",
          "data": {
            "name": "Full feature sent"
          }
        }
      ]
    },
    "monitor": {
      "automation_mode": "parallel",
      "inactive": {
        "enabled": false,
        "items": [],
        "clear_notification": false
      },
      "triggers": {
        "enabled": true,
        "items": [
          {
            "trigger": "state",
            "entity_id": "binary_sensor.door"
          },
          {
            "trigger": "state",
            "entity_id": "binary_sensor.window"
          },
          {
            "trigger": "state",
            "entity_id": "sensor.temperature"
          }
        ]
      },
      "conditions": {
        "startup": true,
        "enabled": true,
        "items": [
          {
            "condition": "and",
            "conditions": [
              {
                "condition": "or",
                "conditions": [
                  {
                    "condition": "state",
                    "entity_id": "binary_sensor.door",
                    "state": "on"
                  },
                  {
                    "condition": "numeric_state",
                    "entity_id": "sensor.temperature",
                    "above": 30
                  }
                ]
              },
              {
                "condition": "state",
                "entity_id": "binary_sensor.window",
                "state": "on"
              }
            ]
          }
        ]
      }
    }
  }
