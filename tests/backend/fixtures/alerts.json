  "full_feature": {
    "id": "full_feature",
    "name": "Full feature",
    "monitor": {
      "on_change": true,
      "startup": true
    },
    "conditions": [{
      "condition": "and",
      "conditions": [
        {
          "condition": "or",
          "conditions": [
            {
              "condition": "state",
              "entity_id": "binary_sensor.door",
              "state": "on"
            },
            {
              "condition": "numeric_state",
              "entity_id": "sensor.temperature",
              "above": 30
            }
          ]
        },
        {
          "condition": "state",
          "entity_id": "binary_sensor.window",
          "state": "on"
        }
      ]
    }],
    "notification": {
      "action": "notify.mobile_app_phone",
      "target": {
        "entity_id": ["notify.mobile_app_phone"]
      },
      "data": {
        "message": "Door open"
      }
    },
    "confirmation": {
      "enabled": true,
      "buttons": [{"id": "confirm", "label": "Confirm"}],
      "reminders": {
        "enabled": true,
        "interval": {"minutes": 15},
        "max_attempts": 5,
        "show_attempts": true
      },
      "notification": {
        "action": "notify.mobile_app_phone",
        "data": {
          "message": "Confirmed"
        }
      },
      "actions": [
        {
          "action": "light.turn_on",
          "target": {
            "entity_id": "light.hall"
          }
        }
      ]
    },
    "post_send_actions": {
      "enabled": true,
      "actions": [{
        "action": "logbook.log",
        "data": {"name": "Full feature sent"}
      }]
    }
  }
}