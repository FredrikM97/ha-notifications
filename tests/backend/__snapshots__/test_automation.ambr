  '''
  id: ha_notifications_matrix_post_send_enabled
  alias: 'HA Notifications: Low water'
  description: Generated by HA Notifications. Do not edit manually.
  initial_state: true
  mode: single
  triggers:
  - trigger: state
    entity_id: sensor.water
  - trigger: homeassistant
    event: start
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: numeric_state
        entity_id: sensor.water
        below: 20
      sequence:
      - action: ha_notifications.report
        data:
          alert_id: matrix_post_send_enabled
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          status: started
          run_id: '{{ context.parent_id or context.id }}'
          details:
            action: automation_started
      - action: ha_notifications.send
        data:
          alert_id: matrix_post_send_enabled
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          target:
            entity_id:
            - notify.phone
            - notify.tablet
          data:
            message: Low water
      - action: logbook.log
      - action: ha_notifications.record
        data:
          alert_id: matrix_post_send_enabled
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          details:
            action: logbook.log
      - action: ha_notifications.report
        data:
          alert_id: matrix_post_send_enabled
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          status: completed
          run_id: '{{ context.parent_id or context.id }}'
          details:
            action: automation_completed
    default:
    - action: ha_notifications.report
      data:
        alert_id: matrix_post_send_enabled
        alert_name: Low water
        flow_id: '{{ context.id }}'
        status: inactive
        message: Condition inactive
        details:
          action: automation_inactive
    - stop: condition inactive
  '''
