# name: test_option_matrix_generates_valid_native_automations[interval_and_clear-overrides1]
  '''
  id: ha_notifications_matrix_interval_and_clear
  alias: 'HA Notifications: Low water'
  description: Generated by HA Notifications. Do not edit manually.
  initial_state: true
  mode: single
  triggers:
  - trigger: state
    entity_id: sensor.water
  - trigger: homeassistant
    event: start
  - trigger: time_pattern
    minutes: /5
  conditions: []
  actions:
  - choose:
    - conditions:
      - condition: numeric_state
        entity_id: sensor.water
        below: 20
      sequence:
      - action: ha_notifications.report
        data:
          alert_id: matrix_interval_and_clear
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          status: started
          run_id: '{{ context.parent_id or context.id }}'
          details:
            action: automation_started
      - action: ha_notifications.send
        data:
          alert_id: matrix_interval_and_clear
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          target:
            entity_id:
            - notify.phone
            - notify.tablet
          data:
            message: Low water
      - action: ha_notifications.report
        data:
          alert_id: matrix_interval_and_clear
          alert_name: Low water
          flow_id: '{{ context.parent_id or context.id }}'
          status: completed
          run_id: '{{ context.parent_id or context.id }}'
          details:
            action: automation_completed
    default:
    - action: ha_notifications.clear
      data:
        alert_id: matrix_interval_and_clear
        alert_name: Low water
        flow_id: '{{ context.id }}'
        target:
          entity_id:
          - notify.phone
          - notify.tablet
        data:
          message: Low water
  '''
