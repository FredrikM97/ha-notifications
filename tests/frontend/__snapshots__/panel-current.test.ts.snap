// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`panel configuration workflows > preserves native durations and omits runtime on save 1`] = `
[
  {
    "alert": {
      "confirmation": {
        "actions": {
          "enabled": true,
          "items": [
            {
              "action": "light.turn_on",
              "target": {
                "entity_id": [
                  "light.hall",
                ],
              },
            },
          ],
        },
        "buttons": [
          {
            "id": "confirm",
            "label": "Close door",
          },
        ],
        "enabled": true,
        "notification": {
          "action": "notify.mobile_app_phone",
          "enabled": true,
          "message": "Front door closed by {{confirmed_by}}.",
          "options": {},
          "title": "Front door",
        },
        "reminders": {
          "enabled": true,
          "forget_after": {
            "enabled": false,
            "value": "00:15:00",
          },
          "interval": {
            "minutes": 30,
          },
          "max_attempts": 3,
          "show_attempts": true,
        },
      },
      "description": "Notify when the front door stays open.",
      "enabled": true,
      "icon": "mdi:door-open",
      "id": "door",
      "monitor": {
        "conditions": {
          "enabled": true,
          "interval": {
            "enabled": true,
            "value": 3600,
          },
          "items": [
            {
              "condition": "state",
              "entity_id": "binary_sensor.front_door",
              "for": "00:05:00",
              "state": "on",
            },
          ],
          "startup": true,
        },
        "inactive": {
          "clear_notification": false,
          "enabled": false,
          "items": [],
        },
        "triggers": {
          "enabled": true,
          "items": [
            {
              "entity_id": "binary_sensor.front_door",
              "trigger": "state",
            },
          ],
        },
      },
      "name": "Front door open",
      "notification": {
        "action": "notify.mobile_app_phone",
        "message": "The front door is still open.",
        "options": {
          "data": {
            "ttl": 0,
          },
          "tag": "{{ trigger.entity_id }}",
        },
        "target": {
          "device_id": [
            "device_phone",
          ],
          "entity_id": [
            "notify.phone",
          ],
        },
        "title": "Front door",
      },
      "post_send_actions": {
        "enabled": true,
        "items": [
          {
            "action": "logbook.log",
            "data": {
              "name": "Front door alert",
            },
          },
        ],
      },
    },
    "type": "ha_notifications/save_config",
  },
]
`;

