exports[`panel configuration workflows > saves a existing alert while preserving other configuration entries 1`] = `
[
  {
    "alert": {
      "enabled": true,
      "id": "door",
      "monitor": {
        "conditions": {
          "enabled": true,
          "interval": {
            "enabled": false,
            "value": 43200,
          },
          "items": [
            {
              "condition": "template",
              "value_template": "{{ true }}",
            },
          ],
          "startup": true,
        },
        "inactive": {
          "clear_notification": false,
          "enabled": false,
          "items": [],
        },
        "triggers": {
          "enabled": true,
          "items": [],
        },
      },
      "name": "Updated alert",
      "notification": {
        "action": "notify.mobile_app_phone",
        "message": "",
        "options": {},
        "target": {
          "entity_id": [
            "notify.phone",
          ],
        },
        "title": "",
      },
    },
    "type": "ha_notifications/save_config",
  },
]
`;

