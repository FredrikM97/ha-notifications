exports[`automation API operations > reloads only the changed ID through its config API update, including on repeated Reload 1`] = `
{
  "reloads": [
    [
      {
        "domain": "automation",
        "service": "reload",
        "service_data": {
          "id": "ha_notifications_first",
        },
        "type": "call_service",
      },
    ],
    [
      {
        "domain": "automation",
        "service": "reload",
        "service_data": {
          "id": "ha_notifications_first",
        },
        "type": "call_service",
      },
    ],
    [
      {
        "domain": "automation",
        "service": "reload",
        "service_data": {
          "id": "ha_notifications_second",
        },
        "type": "call_service",
      },
    ],
  ],
  "writes": [
    [
      "POST",
      "config/automation/config/ha_notifications_second",
      {
        "alias": "Updated",
        "description": "Generated by HA Notifications. Do not edit manually.",
        "id": "ha_notifications_second",
      },
    ],
  ],
}
`;

exports[`automation API operations > saves a single complete automation by stable ID, including its saved enablement 1`] = `
{
  "api": [
    [
      "GET",
      "config/automation/config/ha_notifications_door",
      undefined,
    ],
    [
      "POST",
      "config/automation/config/ha_notifications_door",
      {
        "alias": "door",
        "description": "Generated by HA Notifications. Do not edit manually.",
        "id": "ha_notifications_door",
        "initial_state": false,
      },
    ],
  ],
  "websocket": [
    [
      {
        "alert": {
          "enabled": false,
          "id": "door",
          "monitor": {
            "conditions": {
              "enabled": true,
              "interval": {
                "enabled": false,
                "value": 43200,
              },
              "items": [
                {
                  "condition": "template",
                  "value_template": "{{ true }}",
                },
              ],
              "startup": true,
            },
            "inactive": {
              "clear_notification": false,
              "enabled": false,
              "items": [],
            },
            "triggers": {
              "enabled": true,
              "items": [],
            },
          },
          "name": "Front door",
          "notification": {
            "action": "notify.mobile_app_phone",
            "message": "",
            "options": {},
            "target": {
              "entity_id": [
                "notify.phone",
              ],
            },
            "title": "",
          },
        },
        "type": "ha_notifications/save_config",
      },
    ],
  ],
}
`;

exports[`automation API operations > targets unchanged automations on explicit Reload without rewriting their documents 1`] = `
{
  "api": [
    [
      "GET",
      "config/automation/config/ha_notifications_first",
      undefined,
    ],
    [
      "GET",
      "config/automation/config/ha_notifications_second",
      undefined,
    ],
  ],
  "websocket": [
    [
      {
        "type": "ha_notifications/get_automations",
      },
    ],
    [
      {
        "domain": "automation",
        "service": "reload",
        "service_data": {
          "id": "ha_notifications_first",
        },
        "type": "call_service",
      },
    ],
    [
      {
        "domain": "automation",
        "service": "reload",
        "service_data": {
          "id": "ha_notifications_second",
        },
        "type": "call_service",
      },
    ],
  ],
}
`;

