  "editorAlert": {
    "id": "rich_alert",
    "name": "Front door open",
    "description": "Notify when the front door stays open.",
    "icon": "mdi:door-open",
    "enabled": true,
    "monitor": {
      "automation_mode": "parallel",
      "inactive": {"enabled": false, "items": [], "clear_notification": false},
      "triggers": {
        "enabled": true,
        "items": [{"trigger": "state", "entity_id": "binary_sensor.front_door"}]
      },
      "conditions": {
        "enabled": true,
        "items": [{
          "condition": "state",
          "entity_id": "binary_sensor.front_door",
          "state": "on",
          "for": "00:05:00"
        }],
        "startup": true,
        "periodic": true,
        "interval": 3600
      }
    },
    "notification": {
      "action": "notify.mobile_app_phone",
      "target": {
        "entity_id": ["notify.phone"],
        "device_id": ["device_phone"]
      },
      "data": {"title": "Front door", "message": "The front door is still open."}
    },
    "confirmation": {
      "enabled": true,
      "buttons": [{"id": "confirm", "label": "Close door"}],
      "notification": {
        "action": "notify.mobile_app_phone",
        "data": {"message": "Front door closed by {{confirmed_by}}."}
      },
      "reminders": {
        "enabled": true,
        "interval": "00:30:00",
        "max_attempts": 3,
        "show_attempts": true
      },
      "actions": [{"action": "light.turn_on", "target": {"entity_id": ["light.hall"]}}]
    },
    "post_send_actions": {
      "enabled": true,
      "actions": [{"action": "logbook.log", "data": {"name": "Front door alert"}}]
    }
  }
