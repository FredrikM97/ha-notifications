{
  "config": {
    "version": 1,
    "alerts": []
  },
  "draftTestResult": {
    "session_id": "session"
  },
  "alert": {
    "id": "door",
    "name": "Front door",
    "enabled": true,
    "triggers": [{"trigger": "homeassistant", "event": "start"}],
    "conditions": [{"condition": "template", "value_template": "{{ true }}"}],
    "monitor": {
      "on_change": true,
      "startup": false
    },
    "notification": {
      "action": "notify.mobile_app_phone",
      "target": {
        "entity_id": ["notify.phone"]
      },
      "data": {"title": "", "message": ""}
    }
  },
  "runtime": {
    "door": {
      "config": {"id": "door", "name": "Front door"},
      "state": {"active": true, "flow_id": "flow_door"},
      "trace": [
        {
          "event_id": "event-1",
          "timestamp": "2026-09-23T12:57:37.627672+00:00",
          "type": "notification_sent",
          "message": "Notification sent.",
          "details": {"target": "notify.phone"}
        }
      ]
    }
  },
  "editorAlert": {
    "id": "rich_alert",
    "name": "Front door open",
    "description": "Notify when the front door stays open.",
    "icon": "mdi:door-open",
    "enabled": true,
    "triggers": [{"trigger": "state", "entity_id": "binary_sensor.front_door"}],
    "conditions": [{
      "condition": "state",
      "entity_id": "binary_sensor.front_door",
      "state": "on",
      "for": "00:05:00"
    }],
    "monitor": {
      "on_change": true,
      "startup": true,
      "interval": "01:00:00"
    },
    "notification": {
      "action": "notify.mobile_app_phone",
      "target": {
        "entity_id": ["notify.phone"],
        "device_id": ["device_phone"]
      },
      "data": {"title": "Front door", "message": "The front door is still open."}
    },
    "confirmation": {
      "enabled": true,
      "buttons": [{"id": "confirm", "label": "Close door"}],
      "notification": {
        "action": "notify.mobile_app_phone",
        "data": {"message": "Front door closed by {{confirmed_by}}."}
      },
      "reminders": {
        "enabled": true,
        "interval": "00:30:00",
        "max_attempts": 3,
        "show_attempts": true
      },
      "actions": [{"action": "light.turn_on", "target": {"entity_id": ["light.hall"]}}]
    },
    "post_send_actions": {
      "enabled": true,
      "actions": [{"action": "logbook.log", "data": {"name": "Front door alert"}}]
    }
  }
}
