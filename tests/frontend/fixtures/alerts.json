{
  "config": {
    "version": 1,
    "alerts": []
  },
  "draftTestResult": {
    "session_id": "session"
  },
  "alert": {
    "id": "door",
    "name": "Front door",
    "enabled": true,
    "conditions": [],
    "monitor": {
      "on_change": true,
      "startup": false
    },
    "notification": {
      "target": {
        "entity_id": ["notify.phone"]
      },
      "title": "",
      "message": ""
    }
  },
  "runtime": {
    "door": {
      "active": true,
      "confirmation_attempts": 2
    }
  },
  "editorAlert": {
    "id": "rich_alert",
    "name": "Front door open",
    "description": "Notify when the front door stays open.",
    "icon": "mdi:door-open",
    "enabled": true,
    "conditions": [
      {
        "type": "state",
        "id": "front_door",
        "entity_id": "binary_sensor.front_door",
        "state": "on",
        "for": "00:05:00"
      }
    ],
    "monitor": {
      "on_change": true,
      "startup": true,
      "interval": "01:00:00",
      "retention": {
        "enabled": true,
        "days": 14
      }
    },
    "notification": {
      "target": {
        "entity_id": ["notify.phone"],
        "device_id": ["device_phone"]
      },
      "title": "Front door",
      "message": "The front door is still open."
    },
    "confirmation": {
      "enabled": true,
      "button": "Close door",
      "notification": {
        "enabled": true,
        "message": "Front door closed by {{confirmed_by}}.",
        "clear": false
      },
      "reminders": {
        "enabled": true,
        "interval": "00:30:00",
        "max_attempts": 3,
        "show_attempts": true
      },
      "actions": {
        "enabled": true,
        "items": [{"action": "light.turn_on", "target": {"entity_id": ["light.hall"]}}]
      }
    },
    "post_send_actions": {
      "enabled": true,
      "actions": [{"action": "logbook.log", "data": {"name": "Front door alert"}}]
    }
  }
}
